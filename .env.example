# 转录引擎配置（至少配置一个）
# ============================================

# 通义听悟（阿里云，推荐，中文效果最好）
# 免费额度：每天 2 小时文件转录（90 天试用期）
# 申请：https://tingwu.aliyun.com → 开通服务 → 获取 AppKey
# 同时需要阿里云 AccessKey：https://ram.console.aliyun.com/manage/ak
TINGWU_APP_KEY=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# 通义听悟需要 OSS 中转（仅 audio_to_inbox.py 使用）
# 创建 Bucket：https://oss.console.aliyun.com → 新建 Bucket
TINGWU_OSS_BUCKET=
TINGWU_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com

# Groq Whisper（免费，速度快，中文尚可）
# 免费额度：每天 8 小时音频（永久免费）
# 申请：https://console.groq.com → API Keys
GROQ_API_KEY=

# Cohere Transcribe（免费，垫底 fallback）
# 免费额度：每月 1000 次请求（永久免费）
# 申请：https://dashboard.cohere.com → API Keys
COHERE_API_KEY=

# AI 简报配置（可选，--brief 模式需要）
# ============================================
# 支持任何 OpenAI 兼容 API
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 代理配置（可选）
# ============================================
# Groq 和部分网站需要代理
PODCAST_PROXY=

# 输出目录（可选）
# ============================================
TRANSCRIPT_OUTPUT_DIR=./output
TRANSCRIPT_NOTES_DIR=
